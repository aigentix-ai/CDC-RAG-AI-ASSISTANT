# ==============================================================================
# CDC Regulatory Compliance RAG Assistant — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Backend Server Configuration
FLASK_PORT=5000
FLASK_SECRET_KEY=cdc-regulatory-demo-secret-2026

# Admin Security & Dashboard Access
ADMIN_PASSWORD=cdc-admin-2026

# Google Gemini LLM API Configuration
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector Database & Retrieval Engine Settings
CHROMA_PERSIST_DIR=./vectordb/chroma_store
COLLECTION_NAME=cdc_regulatory_docs
SIMILARITY_TOP_K=5
DISTANCE_THRESHOLD=0.75

# Ingestion & Scraping Defaults
CDC_DEFAULT_DOMAIN=cdcpakistan.com
CRAWL_MAX_PAGES_DEFAULT=25
CRAWL_DELAY_SECONDS_DEFAULT=1.0
